# 后端接口与判题进程共用的镜像。用 Ubuntu 24.04，iverilog / yosys / verilator 版本与开发环境一致，判题结果相同
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# 国内服务器可在 .env 里设镜像源加速（见 docs/deploy.md），不设就用官方源
ARG APT_MIRROR=
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i -e "s#http://archive.ubuntu.com/ubuntu#$APT_MIRROR#g" -e "s#http://security.ubuntu.com/ubuntu#$APT_MIRROR#g" \
        /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends iverilog yosys verilator python3 python3-venv util-linux \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt backend/requirements-deploy.txt backend/
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir -i "$PIP_INDEX_URL" -r backend/requirements-deploy.txt
ENV PATH=/opt/venv/bin:$PATH
COPY judge judge
COPY problems problems
COPY backend backend
# 学生代码在这个用户下编译仿真，不是 root
RUN useradd --create-home --uid 10001 app && mkdir -p /data && chown app:app /data
USER app
EXPOSE 8000
