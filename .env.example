# 只写变量名和默认值；真实的密钥只放在部署环境的环境变量里，不进仓库

# 运行环境：development / production。production 下必须设置 ANON_SALT
APP_ENV=development
# 数据库：开发默认 backend/dev.db（SQLite）；部署用 PostgreSQL，如 postgresql+psycopg://user:pass@host/db
DATABASE_URL=
# 匿名 ID 的盐：anon_id = HMAC-SHA256(ANON_SALT, user_id) 前 8 位
ANON_SALT=
# 登录 Cookie 只走 HTTPS（网站配好 HTTPS 后设为 true；只用 http 访问时保持 false，否则无法登录）
COOKIE_SECURE=false
SESSION_DAYS=14
# 判题
JUDGE_WORKERS=
JUDGE_TIMEOUT_SECONDS=10
JUDGE_LOG_PATH=
PROBLEMS_DIR=
# 判题资源上限（Linux 上用 prlimit；JUDGE_RLIMITS=0 关闭）
JUDGE_RLIMITS=1
JUDGE_MEMORY_MB=2048
JUDGE_OUTPUT_MB=32
# 知情同意书文件（正文 + 版本号），默认 backend/app/data/consent.md
CONSENT_FILE=
# 研究导出目录，默认 backend/exports
EXPORTS_DIR=
# 学情参数
PRED_THRESHOLD=0.8
HINT_INTERVAL_SECONDS=30
# 测试用：任务在请求里同步执行，不需要单独的 worker
JOBS_INLINE=false
# 演示数据脚本 backend/scripts/seed_demo.py 的密码
DEMO_PASSWORD=
# 前端开发服务器（frontend/vite.config.ts）
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_PORT=5173
# 大模型（docs/llm-deepseek.md 第 3 节）。Key 只放在部署环境里
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_DAILY_BUDGET_CNY=20
# 每百万 token 单价（元），按官方价格页高峰价；上线前核对
LLM_PRICE_HIT_CNY=0.04
LLM_PRICE_MISS_CNY=2
LLM_PRICE_OUT_CNY=8
# 助教对话：每个学生每小时最多条数
CHAT_HOURLY_LIMIT=30

# ---- 部署（docker-compose.yml，见 docs/deploy.md）----
POSTGRES_USER=agent
POSTGRES_PASSWORD=
POSTGRES_DB=agent_fpga
# 网站对外端口
WEB_PORT=8080
# 构建镜像时的下载源，留空用官方源。国内服务器可填，例如
#   APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu      （用 http：基础镜像里还没有证书，https 会校验失败）
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=
PIP_INDEX_URL=
NPM_REGISTRY=
